# Export through cloud hosting environment variables; this file is NOT auto-loaded.
DATABASE_URL=mysql+pymysql://quota_app:REPLACE_URL_ENCODED_PASSWORD@MYSQL_PRIVATE_HOST:3306/guagua?charset=utf8mb4
WECHAT_ALLOWED_APPIDS=wxREPLACE_WITH_REAL_APPID
DAILY_FREE_QUOTA=5
# Each distinct share entry rewards once; retries use the same entry_id.
SHARE_REWARD=5
# Close ALL public/default/custom-domain ingress before setting true.
WECHAT_PRIVATE_INGRESS_ONLY=false
# Public media proxy has been disabled.
MEDIA_PROXY_ENABLED=false
PROXY_BASE_URL=

# Apply 003_download_tasks.sql before first use.
# Internal Cloud Run credentials are fetched automatically; no manual COS/API keys.
# Obsolete CLOUD_DOWNLOAD_ENABLED and static secret variables are no longer read.
CLOUD_STORAGE_ENV=prod-d3gk2acox7105dd30
COS_REGION=ap-shanghai
COS_BUCKET=7072-prod-d3gk2acox7105dd30-1385311964
# Objects: img/{uuid}.{ext}, video/{uuid}.{ext}.
DOWNLOAD_MAX_BYTES=536870912
DOWNLOAD_DEADLINE_SECONDS=300

# 微信流量主激励视频广告位 ID，与前端 FEATURES.ads.adUnitId 相同；留空时不开放。
REWARDED_AD_UNIT_ID=adunit-5db13f7adc24db74

# Large or unknown-length files overlap source download with one upload worker.
DOWNLOAD_MULTIPART_THRESHOLD_BYTES=8388608
# Reuse a successful transfer for this exact owner+URL+storage target. 0 disables.
DOWNLOAD_CACHE_SECONDS=300
